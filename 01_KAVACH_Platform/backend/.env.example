# KAVACH Platform Environment Configuration
# Copy this file to .env and set your values. Do NOT commit .env with real credentials.

# Google Gemini API Configuration (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Local Air-Gapped LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AIR_GAPPED_MODE=false

# Vector Database (Qdrant in-memory or server)
QDRANT_HOST=localhost
QDRANT_PORT=6333
